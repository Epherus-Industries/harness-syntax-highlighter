{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "harness",
	"injectionSelector": "L:source.yaml -comment",
	"patterns": [
		{
			"include": "#harness-keywords"
		},
		{
			"include": "#variable-definitions"
		},
		{
			"include": "#variables"
		},
		{
			"include": "#strings"
		}
	],
	"repository": {
		"harness-keywords": {
			"patterns": [
				{
					"match": "^(\\s*)(pipeline|stages?|steps?|stepGroup|execution|rollbackSteps|spec|inputs|outputs|variables)\\s*:",
					"name": "keyword.control"
				},
				{
					"match": "^(\\s*)(name|identifier|type|spec|timeout|when|condition|template|templateRef|versionLabel|templateInputs|shell|source|script|environmentVariables|outputVariables|services|environments|failureStrategies|description|required|value)\\s*:",
					"name": "support.type.property-name"
				},
				{
					"name": "entity.name.type",
					"match": "\\b(Deployment|K8sRollingDeploy|K8sApply|K8sDryRun|K8sRollingRollback|ShellScript|Http|HarnessApproval|JiraCreate|JiraUpdate)\\b"
				},
				{
					"name": "storage.type",
					"match": "\\b(Kubernetes|Rolling|Canary|BlueGreen)\\b"
				}
			]
		},
		"variable-definitions": {
			"patterns": [
				{
					"match": "^\\s*(variables)\\s*:",
					"captures": {
						"1": { "name": "keyword.control"},
						"0": { "name": "meta.key.harness"}
					}
				},
				{
					"match": "^\\s*(-\\s+)?(name|type|description|required|value)\\s*:",
					"captures": {
						"2": { "name": "support.type.property-name" },
						"0": { "name": "meta.type.harness"}
					}
				},
				{
					"name": "storage.type",
					"match": "\\b(Secret|String|Number)\\b"
				},
				{
					"name": "constant.language.boolean",
					"match": "\\b(true|false)\\b"
				},
				{
					"name": "constant.other",
					"match": "<\\+input>"
				}
			]
		},
		"variables": {
			"patterns": [
				{
					"name": "variable.other",
					"match": "<\\+([a-zA-Z_][a-zA-Z0-9_]*\\.)*[a-zA-Z_][a-zA-Z0-9_]*(\\.get\\(\"[^\"]+\"\\))?>"
				},
				{
					"name": "variable.other",
					"match": "<\\+[^>]+>"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.yaml",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"include": "#variables"
				},
				{
					"name": "constant.character.escape.yaml",
					"match": "\\\\."
				}
			]
		}
	},
	"scopeName": "source.harness"
}
